{
  "name": "aud_midi_android",
  "summary": "The Android backend of aud_midi: android.media.midi through jnigen bindings and a Java shim, AMidi through FFI for timestamped sends, BLE-MIDI, static virtual devices, NsdManager advertising.",
  "domain": [
    "Android MIDI backend (MidiManager, UMP devices API 33, AMidi API 29)",
    "Java shim: receiver buffer, native tap calls through JNI, device/scan callbacks, MidiDeviceService/MidiUmpDeviceService, context provider, loopback test services",
    "Native tap library (build hook): slot table, UMP assembler, gone from the device callback",
    "jnigen + ffigen bindings, verified on the emulator incl. R8"
  ],
  "interfaces": {
    "uses": {
      "aud_midi_core": "MidiBackend, MidiNativeTapBackend, MidiBluetoothBackend, MidiVirtualPortsBackend, MidiServiceAdvertiser, MidiClockMapper, MidiException",
      "aud_midi_standard": "port/device/capability models, MidiBytesPacket, MidiUmpPacket, Ump",
      "jni": "JNI runtime of the jnigen bindings, interface implementation from Dart"
    },
    "usedBy": {
      "aud_midi": "AndroidMidiBackend on Android; MidiAndroidServiceAdvertiser and MidiAndroidMulticastLock for the AppleMIDI session"
    }
  }
}
